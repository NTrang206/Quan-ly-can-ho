  <diagram id="sq11" name="SQ11_TroLyAI_TomTatHopDong">
    <mxGraphModel dx="1600" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
<mxCell id="c_2" value="&lt;div style='font-family: Arial, sans-serif; font-size: 11px; line-height: 1.5; color: #111827;'&gt;&lt;div style='font-weight: bold; margin-bottom: 8px; color: #0f172a; font-size: 11.5px;'&gt;BASIC COURSE:&lt;/div&gt;&lt;div style='margin-bottom: 10px; text-align: justify;'&gt;Nhân viên truy cập vào Màn hình Chi tiết Hồ sơ Hợp đồng và nhấn nút Trợ lý AI Tóm tắt HĐ.&lt;/div&gt;&lt;div style='margin-bottom: 10px; text-align: justify;'&gt;Hệ thống trích xuất toàn văn hợp đồng số hóa, gửi yêu cầu phân tích đến Mô-đun Trí tuệ Nhân tạo (AI Core Service).&lt;/div&gt;&lt;div style='margin-bottom: 10px; text-align: justify;'&gt;Mô-đun AI phân tích ngôn ngữ tự nhiên, trích xuất 5 nhóm điều khoản trọng yếu (quy định thanh toán, phụ phí, điều kiện phạt, nghĩa vụ bàn giao, thời hạn thông báo trả phòng), trả kết quả tóm tắt cho hệ thống và ghi nhận Nhật ký AI.&lt;/div&gt;&lt;div style='margin-bottom: 10px; text-align: justify;'&gt;Hệ thống hiển thị Bảng Tóm tắt Thông minh cho nhân viên rà soát và lưu vào hồ sơ tóm lược của hợp đồng.&lt;/div&gt;&lt;div style='font-weight: bold; margin-top: 14px; margin-bottom: 8px; color: #991b1b; font-size: 11.5px;'&gt;ALTERNATE COURSE:&lt;/div&gt;&lt;div style='margin-bottom: 10px; text-align: justify;'&gt;&lt;b&gt;AI Service phản hồi lỗi / Quá hạn thời gian:&lt;/b&gt; Tại bước gọi mô-đun AI, kết nối mạng gặp sự cố hoặc thời gian chờ vượt quá 10 giây (timeout). Hệ thống thông báo lỗi dịch vụ AI và cho phép nhân viên nhập tóm tắt thủ công.&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=14;spacingBottom=14;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="55" width="270" height="865" as="geometry" />
        </mxCell>
